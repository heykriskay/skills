{
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~*",
      "effect": "deny"
    }
  ]
}
